#!/usr/bin/env python3
"""abyss-agent: does the privileged-ish desktop work for Abyss, as the user.

Beast OS (a locked-down system service) can't mount FUSE filesystems or open
windows. This small user service can. It listens on a 0600 unix socket and
only accepts the same user (SO_PEERCRED). It never stores keys: Beast OS sends
the vault password for each mount and it goes straight to gocryptfs on stdin.

ops: init, mount, umount, status, run
"""
import json
import os
import shutil
import socket
import struct
import subprocess
import sys

HOME = os.path.expanduser("~")
SOCK = os.path.join(HOME, ".config", "beast-os", "abyss.sock")
FOLDERS = ["Pictures", "Music", "Videos", "Documents", "Desktop", "Downloads"]
# Vaults mount at a hidden path (a dot in the path keeps them out of the file
# manager's sidebar). While unlocked, each personal folder gets an "Abyss" link
# into its vault; locking removes the link, so a locked folder shows nothing.
MNT = os.path.join(HOME, ".local", "share", "beast-os", "abyss")
# Apps that can open inside Abyss: no network, saves stay in the Abyss folder.
APPS = {"blender": ["blender"], "kdenlive": ["kdenlive"], "gimp": ["gimp"], "inkscape": ["inkscape"],
        "audacity": ["audacity"], "libreoffice": ["libreoffice"], "vlc": ["vlc"], "files": ["nemo", "--no-desktop", "."]}
WARROOM = os.path.join(HOME, "Beast_War-room")
SLICE = "abyss-apps.slice"


def cipher(folder):
    return os.path.join(HOME, folder, ".abyss")


def mnt(folder):
    return os.path.join(MNT, folder)


def plain(folder):
    """The visible door inside the personal folder (a link, only there while unlocked)."""
    return os.path.join(HOME, folder, "Abyss")


def mounted(path):
    return os.path.ismount(os.path.realpath(path))


def show_door(f):
    p = plain(f)
    if os.path.islink(p):
        if os.readlink(p) == mnt(f):
            return
        os.unlink(p)
    elif os.path.isdir(p):
        if os.path.ismount(p) or os.listdir(p):
            return               # an old-style mount or real files: never touch it
        os.rmdir(p)
    elif os.path.exists(p):
        return
    os.makedirs(os.path.join(HOME, f), exist_ok=True)
    os.symlink(mnt(f), p)


def hide_door(f):
    p = plain(f)
    if os.path.islink(p) and os.readlink(p) == mnt(f):
        os.unlink(p)
    elif os.path.isdir(p) and not os.path.ismount(p) and not os.listdir(p):
        os.rmdir(p)              # empty leftover from the old layout


def op_init(req):
    out = {}
    for f in FOLDERS:
        c = cipher(f)
        if os.path.exists(os.path.join(c, "gocryptfs.conf")):
            out[f] = "exists"
            continue
        os.makedirs(c, mode=0o700, exist_ok=True)
        r = subprocess.run(["gocryptfs", "-init", "-q", c], input=req["password"] + "\n",
                           capture_output=True, text=True, timeout=120)
        out[f] = "ok" if r.returncode == 0 else ("error: " + r.stderr.strip()[-200:])
    return out


def op_mount(req):
    out = {}
    for f in FOLDERS:
        c, p = cipher(f), plain(f)
        if not os.path.exists(os.path.join(c, "gocryptfs.conf")):
            # set up on first unlock (e.g. the pattern was made before gocryptfs was installed)
            os.makedirs(c, mode=0o700, exist_ok=True)
            r = subprocess.run(["gocryptfs", "-init", "-q", c], input=req["password"] + "\n",
                               capture_output=True, text=True, timeout=120)
            if r.returncode:
                out[f] = "error: " + r.stderr.strip()[-200:]
                continue
        m = mnt(f)
        if os.path.ismount(p) and not os.path.islink(p):
            subprocess.run(["fusermount3", "-u", p], capture_output=True)   # old layout: move it to the hidden path
        os.makedirs(m, mode=0o700, exist_ok=True)
        if not os.path.ismount(m):
            r = subprocess.run(["gocryptfs", "-q", "-noprealloc", c, m], input=req["password"] + "\n",
                               capture_output=True, text=True, timeout=120)
            if r.returncode:
                out[f] = "error: " + r.stderr.strip()[-200:]
                continue
        show_door(f)
        out[f] = "mounted"
    return out


def op_umount(req):
    # close Abyss apps first so they get a chance to save
    subprocess.run(["systemctl", "--user", "stop", SLICE], capture_output=True, timeout=60)
    out = {}
    for f in FOLDERS:
        hide_door(f)
        out[f] = "locked"
        for p in (mnt(f), plain(f)):
            if os.path.ismount(p) and not os.path.islink(p):
                r = subprocess.run(["fusermount3", "-u", p], capture_output=True, text=True)
                if r.returncode:
                    r = subprocess.run(["fusermount3", "-uz", p], capture_output=True, text=True)
                if r.returncode:
                    out[f] = "error: " + r.stderr.strip()[-200:]
        hide_door(f)
    return out


def op_status(req):
    out = {}
    for f in FOLDERS:
        m = os.path.ismount(mnt(f))
        if not m:
            hide_door(f)         # e.g. after a crash or reboot: no door while locked
        out[f] = {"setup": os.path.exists(os.path.join(cipher(f), "gocryptfs.conf")), "mounted": m}
    return out


def op_run(req):
    app, sub, net = req["app"], req.get("sub", ""), req.get("net", "none")
    if app not in APPS or not shutil.which(APPS[app][0]):
        raise ValueError("unknown app")
    folder, _, rest = sub.partition("/")
    if folder not in FOLDERS or ".." in sub.split("/"):
        raise ValueError("bad sub-vault")
    root = mnt(folder)
    if not os.path.ismount(root):
        raise PermissionError("Abyss is locked")
    work = os.path.join(root, rest) if rest else (root if app == "files" else os.path.join(root, app.capitalize()))
    os.makedirs(work, mode=0o700, exist_ok=True)
    workdir = os.path.join(HOME, "AbyssWork")
    os.makedirs(workdir, exist_ok=True)
    cmd = ["systemd-run", "--user", "--scope", "--slice", SLICE, "--collect", "-q",
           "bwrap", "--dev-bind", "/", "/", "--bind", work, workdir, "--chdir", workdir]
    if net == "none":
        cmd.append("--unshare-net")
    cmd += APPS[app]
    env = dict(os.environ)
    subprocess.Popen(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {"running": app, "saves_to": sub or folder + "/" + app.capitalize(), "network": net}


def op_wr_list(req):
    """War Room's own action list (defaults + your edits in user.json)."""
    r = subprocess.run([sys.executable, "-c", "import json; from core.actions import public_list; print(json.dumps(public_list()))"],
                       cwd=WARROOM, capture_output=True, text=True, timeout=15)
    if r.returncode:
        raise RuntimeError("War Room actions unavailable: " + r.stderr.strip()[-200:])
    return json.loads(r.stdout)


def op_wr_run(req):
    aid = str(req.get("id", ""))
    if aid not in {a["id"] for a in op_wr_list({})}:
        raise ValueError("unknown War Room action")
    subprocess.Popen([sys.executable, "-m", "core.actions", aid], cwd=WARROOM,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {"ran": aid}


# ---- Studio: your creative tools, started on demand, loopback only
STUDIO = {
    "framegrabber": {"run": os.path.join(HOME, ".cache", "frame-grabber", "run.json"),
                     "cmd": ["python3", os.path.join(HOME, "frame-grabber", "grabber.py"), "--no-open", "--port", "8781"]},
    "riggallery": {"port": 4177, "cmd": [os.path.join(HOME, ".local", "opt", "node", "bin", "node"),
                                         os.path.join(HOME, "rig-gallery", "src", "server.js")]},
}


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _port_open(port):
    s = socket.socket()
    s.settimeout(0.3)
    try:
        return s.connect_ex(("127.0.0.1", port)) == 0
    finally:
        s.close()


def op_studio_open(req):
    import time
    tool, sub = req.get("tool"), req.get("view", "grabber")
    if tool == "framegrabber":
        t = STUDIO[tool]
        def url():
            try:
                r = json.load(open(t["run"]))
                if _alive(r["pid"]):
                    return f"http://127.0.0.1:{r['port']}/?t={r['token']}&tool={'gallery' if sub == 'gallery' else 'grabber'}"
            except (OSError, ValueError, KeyError):
                return None
        u = url()
        if not u:
            subprocess.Popen(t["cmd"] + ["--tool", "gallery" if sub == "gallery" else "grabber"], cwd=os.path.dirname(t["cmd"][1]),
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            for _ in range(40):
                time.sleep(0.25)
                u = url()
                if u:
                    break
        if not u:
            raise RuntimeError("Frame Grabber didn't start")
        return {"url": u}
    if tool == "riggallery":
        t = STUDIO[tool]
        if not os.path.exists(t["cmd"][0]):
            raise RuntimeError("Node isn't installed yet")
        if not _port_open(t["port"]):
            env = dict(os.environ, FTB_PORT=str(t["port"]), FTB_HOST="127.0.0.1",
                       FTB_DATA_DIR=os.path.join(HOME, ".local", "share", "rig-gallery"))
            subprocess.Popen(t["cmd"], cwd=os.path.join(HOME, "rig-gallery"), env=env,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            for _ in range(40):
                time.sleep(0.25)
                if _port_open(t["port"]):
                    break
        return {"url": f"http://127.0.0.1:{t['port']}/"}
    raise ValueError("unknown studio tool")


# ---- Frame Grabber engine for Storyboard process nodes (files stay inside Abyss)
FG = os.path.join(HOME, "frame-grabber")
FG_PY = os.path.join(FG, ".venv", "bin", "python")
FG_TASKS = ("cutout", "parts", "plate", "filter", "upscale", "gif")
JOBS = {}


def _fg_presets():
    r = subprocess.run([FG_PY, "-c", "import json; from filters_meta import PRESETS; print(json.dumps(PRESETS))"],
                       cwd=FG, capture_output=True, text=True, timeout=30)
    return json.loads(r.stdout or "{}")


def op_fg_presets(req):
    return {k: v.get("desc", "") for k, v in _fg_presets().items()}


def _inside_abyss(path):
    real = os.path.realpath(path)
    for f in FOLDERS:
        root = os.path.realpath(mnt(f))
        if (real == root or real.startswith(root + os.sep)) and os.path.ismount(root):
            return real
    raise PermissionError("Storyboard files must be inside an unlocked Abyss folder")


def _run_fg(jid, task, inputs, outdir, prefix, options):
    import threading, time, shutil as sh
    J = JOBS[jid]
    stage = os.path.join(outdir, ".stage-" + jid)
    try:
        os.makedirs(os.path.join(stage, "out"), exist_ok=True)
        if task == "gif":
            from PIL import Image
            frames = [Image.open(p).convert("RGBA") for p in inputs]
            w = min(int(options.get("width") or 480), frames[0].width)
            frames = [f.resize((w, max(1, int(f.height * w / f.width)))) for f in frames]
            name = f"{prefix}-anim.gif"
            frames[0].save(os.path.join(outdir, name), save_all=True, append_images=frames[1:],
                           duration=int(1000 / max(0.5, float(options.get("fps") or 8))), loop=0, disposal=2)
            J.update(state="done", outs=[{"file": name, "variant": "animation"}], progress=1)
            return
        opts = dict(options)
        if task == "filter":
            pre = _fg_presets().get(opts.pop("preset", ""), None)
            if not pre:
                raise ValueError("pick a look")
            opts["steps"] = pre["steps"]
        if task == "upscale":
            opts.setdefault("method", "fast")
        job = {"task": task, "inputs": [{"id": i, "path": p} for i, p in enumerate(inputs)],
               "outdir": os.path.join(stage, "out"), "options": opts, "tag": prefix}
        with open(os.path.join(stage, "job.json"), "w") as f:
            json.dump(job, f)
        proc = subprocess.Popen([FG_PY, os.path.join(FG, "worker.py"), os.path.join(stage, "job.json")], cwd=FG,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                env=dict(os.environ, OMP_NUM_THREADS="2"))
        J["pid"] = proc.pid
        outs, err = [], None
        for line in proc.stdout:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if "out" in m:
                o = m["out"]
                tag = o.get("part") or o.get("variant", "out")
                final = f"{prefix}-{o.get('src', 0):02d}-{tag}{os.path.splitext(o['file'])[1]}"
                sh.move(os.path.join(stage, "out", o["file"]), os.path.join(outdir, final))
                outs.append({"file": final, "variant": o.get("variant"), "part": o.get("part")})
                J["outs"] = list(outs)
            elif "progress" in m:
                J["progress"] = min(1.0, m["progress"] / max(1, m.get("total") or len(inputs)))
            elif "phase" in m:
                J["phase"] = m["phase"]
            elif "error" in m:
                err = m["error"]
        proc.wait()
        if proc.returncode or err:
            raise RuntimeError(err or proc.stderr.read()[-300:] or "the engine stopped")
        J.update(state="done", progress=1, outs=outs)
    except Exception as e:
        J.update(state="error", error=str(e)[:300])
    finally:
        sh.rmtree(stage, ignore_errors=True)


def op_fg_run(req):
    import threading, secrets as sc
    task = req.get("task")
    if task not in FG_TASKS:
        raise ValueError("unknown process")
    if task != "gif" and not os.path.exists(FG_PY):
        raise RuntimeError("Frame Grabber's tools aren't installed")
    inputs = [_inside_abyss(p) for p in req.get("inputs", [])]
    if not inputs:
        raise ValueError("nothing wired into this node yet")
    if task == "gif" and len(inputs) < 2:
        raise ValueError("a GIF needs at least 2 pictures")
    outdir = _inside_abyss(req["outdir"])
    prefix = "".join(c for c in str(req.get("prefix", "p")) if c.isalnum() or c in "-_")[:40] or "p"
    jid = sc.token_hex(6)
    JOBS[jid] = {"state": "running", "progress": 0, "phase": "starting", "outs": []}
    threading.Thread(target=_run_fg, args=(jid, task, inputs, outdir, prefix, req.get("options") or {}), daemon=True).start()
    return {"job": jid}


def op_fg_job(req):
    j = JOBS.get(req.get("job"))
    if not j:
        raise ValueError("no such job")
    return {k: v for k, v in j.items() if k != "pid"}


OPS = {"fg_presets": op_fg_presets, "fg_run": op_fg_run, "fg_job": op_fg_job, "studio_open": op_studio_open, "init": op_init, "mount": op_mount, "umount": op_umount, "status": op_status, "run": op_run,
       "wr_list": op_wr_list, "wr_run": op_wr_run}


def serve():
    os.makedirs(os.path.dirname(SOCK), mode=0o700, exist_ok=True)
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old = os.umask(0o177)
    srv.bind(SOCK)
    os.umask(old)
    srv.listen(4)
    me = os.getuid()
    while True:
        conn, _ = srv.accept()
        with conn:
            try:
                pid, uid, gid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                if uid != me:
                    continue
                data = b""
                while not data.endswith(b"\n"):
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    data += chunk
                req = json.loads(data or b"{}")
                fn = OPS.get(req.get("op"))
                res = {"ok": True, "result": fn(req)} if fn else {"ok": False, "error": "unknown op"}
            except Exception as e:
                res = {"ok": False, "error": str(e)[:300]}
            try:
                conn.sendall(json.dumps(res).encode() + b"\n")
            except OSError:
                pass


if __name__ == "__main__":
    if not shutil.which("gocryptfs"):
        print("abyss-agent: gocryptfs is not installed", file=sys.stderr)
    serve()
